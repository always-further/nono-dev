{
  "extends": "claude",
  "meta": {
    "name": "nono-dev",
    "description": "Claude Code with nono-dev CLI, Lima VM access, and git/GitHub access"
  },
  "filesystem": {
    "read": [
      "$HOME/.lima",
      "$HOME/.local/share/nono-dev/graphs"
    ],
    "read_file": [
      "$HOME/.gitconfig.local",
      "$HOME/.config/gh/hosts.yml",
      "$HOME/.config/gh/config.yml"
    ]
  }
}
